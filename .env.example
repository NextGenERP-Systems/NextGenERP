# ==============================================================================
# NextGen ERP — Environment Variables Template
# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit .env to version control (it is in .gitignore).
# ==============================================================================

# --- Database ---
# Strong password for the PostgreSQL database (min 16 chars recommended)
DB_PASSWORD=change_me_strong_password_here

# --- JWT Authentication ---
# Generate a secure secret with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=nextgen-erp-7753216
